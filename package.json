{
  "name": "halloween-velez-lopez",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "La urna embrujada de la familia Vélez López",
  "scripts": {
    "pretest": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs --demo",
    "prestart": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "admin:reset": "node --env-file=.env.local scripts/reset-admin.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "google-auth-library": "11.3.1",
    "gsap": "3.15.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "sharp": "0.35.5"
  }
}
