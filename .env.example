# Solo servidor. Configurar en Vercel > Settings > Environment Variables.
# No subir archivos .env ni las credenciales JSON de Google al repositorio.
DATABASE_URL=
ADMIN_PASSWORD=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Para pruebas locales: copiar a .env.local y ejecutar npm start.
# La versión local usa un archivo privado en .local/ y no necesita DATABASE_URL.
